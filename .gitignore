.DS_Store
.gitignore
node_modules
public
prof
tsconfig.tsbuildinfo
.obsidian
.quartz-cache
private/
content/templates/
# Drafts never leave the machine: not built, not committed (2026-09-17)
content/drafts/
# Personas are local-only; taxonomy.md is tracked so CI can validate against it
content/personas/*
!content/personas/taxonomy.md
!content/personas/content-review-queue.md
content/Courses/course-style-guide.md
content/Courses/demo.md
content/Newsletters/*-newsletter-draft.md
content/Newsletters/*-newsletter-kit.md
content/Newsletters/*-kit.md
.replit
replit.nix

# PFL format library (2026-09-27): templates, themes and builders stay private.
# Only the michael identity tokens are tracked — the deploy reads them, and the
# built site's CSS publishes the same values anyway.
formats/*
!formats/identities/
formats/identities/*
!formats/identities/michael.css
